# Exemplo de variáveis de ambiente do dispensador (nunca guardar segredos aqui)
#
# Copie para `config/.env` (fora do repo, permissão 600) na instalação.
# Segredos (credenciais do backend) ficam em arquivo próprio, também 600,
# fora do repositório.

# Identidade do paciente atendido (uid no Firestore do app)
DISPENSER_USER_ID=

# Caminho estável da placa controladora (ver docs/HARDWARE.md e uudev)
SERIAL_BY_ID=/dev/serial/by-id/usb-<placa>

# Banco local (cache de agenda + fila de eventos)
DISPENSER_DB_PATH=/var/lib/dispenser/state.db

# Projeto Firebase do app
FIREBASE_PROJECT_ID=app-saude-8fba1

# Intervalo do polling de agenda em segundos (ADR 005)
SYNC_INTERVAL_S=15

# Arquivo de credencial do dispensador (não versionar): chmod 600
DISPENSER_CREDENTIALS_PATH=