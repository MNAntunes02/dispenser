# Configuração do dispensador (sem segredos).
#
# No Raspberry Pi este arquivo é instalado em `/etc/dispenser/dispenser.conf`
# (permissão 640, grupo `dispenser`) e lido pela unit `dispenser-core.service`.
# No desenvolvimento, copie para um `.env` fora do repo e carregue à mão.
#
# Segredos (credenciais do backend) NÃO ficam aqui: vão em arquivo próprio
# com permissão 600, fora do repositório. Ver `DISPENSER_CREDENTIALS_PATH`.

# --- Relógio e fuso (Fase 7, ADR 012) -----------------------------------------
# Fuso do paciente: a agenda ("08:00 do remédio") é sempre interpretada aqui,
# mesmo que o SO do Pi esteja em outro fuso. Decisão do usuário.
DISPENSER_TZ=America/Sao_Paulo

# Piso de data: o Raspberry Pi não tem RTC de fábrica, então sem NTP a hora
# pode ser 1970. Abaixo desta data o core NÃO dispara dose, avisa na tela e
# manda um aviso ao cuidador quando o relógio volta.
DISPENSER_DATA_MINIMA=2024-01-01

# Salto de relógio aceito (s) antes de considerar a hora "instável". Com NTP
# perdido, o relógio volta ao horário de fábrica e salta para trás.
DISPENSER_TOLERANCIA_SALTO_S=300

# Dose mais atrasada que isto ainda dispara ao ligar o aparelho. Acima disso a
# ocorrência é marcada como não atendida e entra no aviso agregado.
DISPENSER_JANELA_ATRASO_S=900

# --- Disco e logs (Fase 7, ADR 013) -------------------------------------------
# Banco local: cache de agenda + fila de eventos. No SD, com WAL.
DISPENSER_DB_PATH=/var/lib/dispenser/state.db

# Retenção da trilha local (log_eventos). A fila de eventos pendentes NUNCA é
# purgada: é o que garante não perder um aviso na falta de rede.
DISPENSER_RETENCAO_LOG_DIAS=90

# --- Boot e systemd (Fase 7, ADR 011) -----------------------------------------
# Socket core <-> UI (Unix domain socket em /run, que é tmpfs).
DISPENSER_SOCKET=/run/dispenser/core.sock

# Frequência do heartbeat da UI (s).
DISPENSER_UI_HEALTH_S=2

# Intervalo entre pulsos de watchdog (s). A unit usa WatchdogSec=45: se o core
# ficar 45 s sem pulsar, o systemd o reinicia.
DISPENSER_WATCHDOG_S=15

# Lock de instância única: impede dois cores no mesmo banco (alarmem fora de
# hora). Fica em /run (tmpfs), então some sozinho no boot.
DISPENSER_LOCK_PATH=/run/dispenser/core.lock

# --- Placa e hardware ---------------------------------------------------------
# Caminho estável da placa controladora (ver docs/HARDWARE.md e deploy/udev/).
SERIAL_BY_ID=/dev/dispenser-board

# --- Backend (Fase 3) --------------------------------------------------------
# Identidade do paciente atendido (uid no Firestore do app)
DISPENSER_USER_ID=

# Projeto Firebase do app
FIREBASE_PROJECT_ID=app-saude-8fba1

# Chave de API pública do projeto Firebase (idem app: firebase_options.dart).
# Não é segredo: é a mesma do aplicativo.
DISPENSER_FIREBASE_API_KEY=

# Arquivo de credencial do dispensador (não versionar): chmod 600.
# Formato JSON: {"email": "...", "senha": "...", "uid": "..."}
# (usuário Firebase Auth do dispensador; o uid é anotado no console — é o UID
# exposto via BLE e usado no vínculo Dispensadores/{uid}).
DISPENSER_CREDENTIALS_PATH=

# Intervalo do polling de agenda em segundos (ADR 005)
SYNC_INTERVAL_S=15

# Agenda de demonstração (JSON, sem backend). Só para desenvolvimento.
# DISPENSER_AGENDA_JSON=/caminho/agenda.json

# --- Provisionamento / Bluetooth (Fase 3b) ------------------------------------
# Local onde o provisionamento grava a configuração recebida via BLE
# (permissão 600, sem senha de rede). Enquanto o arquivo não existir, o core
# não sincroniza e o `dispenser-provision` fica esperando o pareamento.
# Opcional quando BLE não é usado.
# DISPENSER_ENV_PATH=/var/lib/dispenser/dispenser.env

# --- Fluxo de dose (docs/fluxo-dose.md, ADR 006) ------------------------------
DISPENSER_TICK_S=5
DISPENSER_ALARME_INTERVALO_S=120
DISPENSER_MAX_TENTATIVAS=5
DISPENSER_TIMEOUT_GAVETA_S=120
DISPENSER_TIMEOUT_RETORNO_S=120
DISPENSER_LIMITE_RETORNO_S=1800
